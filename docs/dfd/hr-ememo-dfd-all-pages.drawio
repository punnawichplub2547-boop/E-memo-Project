      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="_t" value="DFD Level 2  —  แตกโปรเซส P5  แจ้งเตือน &amp;amp; กระจายช่องทาง" style="text;html=1;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="14" width="2220" height="36" as="geometry" /></mxCell>
