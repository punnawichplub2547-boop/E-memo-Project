<mxCell id="wftitle" value="HR&amp;GA E-Memo — User Flow (flow การใช้งานสำหรับผู้ใช้ทั่วไป)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="760" height="34" as="geometry"/></mxCell>
<mxCell id="n_start" value="Start&#xa;เข้าเว็บ E-Memo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="40" width="280" height="64" as="geometry"/></mxCell>
<mxCell id="d_account" value="Have account?&#xa;มีบัญชีแล้วหรือยัง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#6b4a00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="n_register" value="Register  /register&#xa;กรอกรหัสพนักงาน ชื่อ อีเมล แผนก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="180" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="n_wait_admin" value="Wait for admin&#xa;รอ Admin อนุมัติบัญชี&#xa;และกำหนดสิทธิ์ (role) ให้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;fontColor=#7a3d05;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n_login" value="Login  /login&#xa;อีเมล + รหัสผ่าน (ลืมรหัสได้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="305" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="n_dashboard" value="Dashboard  /&#xa;งานค้าง สถานะล่าสุด กระดิ่งแจ้งเตือน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="430" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="n_create" value="Create Memo  /create&#xa;กดสร้างเมโมใหม่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="550" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="n_step1" value="Step 1 — Memo details&#xa;เรื่อง แผนก ประเภท รายการที่ขอ&#xa;งบประมาณ เปรียบเทียบราคา ไฟล์แนบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="680" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="n_ai" value="Helpers (optional)&#xa;AI ช่วยร่างข้อความ · ดึงข้อมูลจาก&#xa;ใบเสนอราคา PDF · โหลดเทมเพลต" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#05403a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="685" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="n_step2" value="Step 2 — Approval route&#xa;เลือกผู้อนุมัติปลายทาง + ผู้รับทราบ (Read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="830" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="n_recommend" value="System recommends&#xa;ระบบแนะนำผู้อนุมัติให้อัตโนมัติ&#xa;เปลี่ยนเองได้ แต่ต้องระบุเหตุผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#3730A3;fontColor=#1e1b4b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="n_step3" value="Step 3 — Review &amp; send&#xa;ตรวจทานร่างเมโมก่อนส่ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="980" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="d_send" value="Send now?&#xa;ส่งเลย หรือ เก็บร่าง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#6b4a00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="1090" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="n_draft" value="Draft saved&#xa;เก็บร่างไว้ ยังไม่เข้าสายอนุมัติ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1110" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="n_pending" value="Status: Pending&#xa;เมโมเข้าสู่สายอนุมัติแล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="1230" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="n_notify" value="Notifications&#xa;กระดิ่งในระบบ + อีเมล + Telegram&#xa;แจ้งผู้ขอ ผู้ถูก CC และผู้อนุมัติคนถัดไป" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#CA8A04;fontColor=#6b4a00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1220" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="n_manager" value="First step — Manager / Top Section&#xa;ด่านแรกบังคับเสมอ (ตรวจแล้ว/ผ่าน)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="1360" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="n_read" value="Read recipients&#xa;ผู้รับทราบกด Mark Read&#xa;ต้องครบก่อนอนุมัติ หรือขอข้ามพร้อมเหตุผล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#05403a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1355" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="d_mdreview" value="MD Review?&#xa;กรณีซัพพลายเออร์ขึ้นราคา" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#6b4a00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="1500" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="n_mdgate" value="MD Review gate&#xa;MD เลือก: ไม่มีข้อโต้แย้ง / ให้ความเห็น /&#xa;ขอแก้ไข / ยกระดับเป็นผู้อนุมัติเอง&#xa;(workflow หยุดรอจนกว่าจะผ่านด่านนี้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;fontColor=#7a3d05;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1500" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="n_approver_step" value="Approver reviews&#xa;ผู้อนุมัติตามเส้นทาง (Manager &gt; GM &gt; MD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="1670" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="d_decision" value="Decision?&#xa;ผู้อนุมัติตัดสินอย่างไร?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#6b4a00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="1800" width="250" height="120" as="geometry"/></mxCell>
<mxCell id="n_returned" value="Returned&#xa;ส่งกลับพร้อมเหตุผล + ระบุขั้นที่ให้กลับไป" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;fontColor=#7a3d05;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1820" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n_rejected" value="Rejected&#xa;ปฏิเสธ: ปิดคำขอ หรือ อนุญาตให้แก้ไข" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7a1414;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1820" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n_resubmit" value="Edit &amp; resubmit&#xa;ผู้ขอแก้ไขแล้วส่งใหม่ (เลข Rev. เพิ่มขึ้น)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A8A;fontColor=#10243f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1950" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="d_more" value="More steps?&#xa;ยังมีผู้อนุมัติถัดไปไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#6b4a00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="2010" width="220" height="110" as="geometry"/></mxCell>
